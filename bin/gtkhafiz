import os
import importlib


exe_name = os.path.basename(__file__)
prefix = os.path.dirname(__file__).replace("/bin", "")

module = importlib.import_module(f"{exe_name}.main")
main = getattr(module, "main")

if __name__ == "__main__":
    main(exe_name, prefix)
